# Copy this file to `.env` and adjust the values for local development.
# The app reads the VITE_* variables at build time and falls back to the
# defaults when they are unset (see src/config/runtimeConfig.ts).

# Base URL of a Tiled server, e.g. http://localhost:8000/api/v1 or a relative
# same-origin path such as /tiled/<host>/api/v1 (dev proxy).
VITE_TILED_API_URL=http://localhost:8000/api/v1

# Optional API key for single-user Tiled servers.
VITE_TILED_API_KEY=
